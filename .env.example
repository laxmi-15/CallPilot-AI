# ==============================================================================
# CallPilot AI - Environment Variables (.env.local)
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. Google Gemini API (AI Reasoning & Entity Extraction)
# Free Tier: Free at https://aistudio.google.com
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 2. Sarvam AI (Real Multilingual Voice: Saaras v3 STT & Bulbul v3 TTS)
# Free Tier Signup Credits: https://www.sarvam.ai
# Supported: English (en-IN), Hindi (hi-IN), Kannada (kn-IN)
# IMPORTANT: Keep server-side only. NEVER prefix with NEXT_PUBLIC_
# ------------------------------------------------------------------------------
SARVAM_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Supabase (Database + Auth + CRM Storage)
# Free Tier: 2 active projects, 500MB DB, 50k MAU
# https://supabase.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 4. Google Calendar API v3 (Availability, Booking, Reschedule, Cancel)
# Free Tier: 1,000,000 queries/day at https://console.cloud.google.com
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# ZERO OUT-OF-POCKET EXPENSE GUARANTEE
# ------------------------------------------------------------------------------
# ❌ Twilio       -> NOT NEEDED ($0 out of pocket)
# ❌ OpenAI Voice -> NOT NEEDED (Gemini + Sarvam AI free tier used)
# ❌ ElevenLabs   -> NOT NEEDED (Sarvam Bulbul v3 free tier used)
# ❌ Deepgram     -> NOT NEEDED (Sarvam Saaras v3 free tier used)
